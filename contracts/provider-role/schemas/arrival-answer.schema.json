{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:rutent:provider-role:arrival-answer",
  "title": "Arrival answer",
  "description": "A reserve's own signed answer to the operator's question of what arrived (urn:rutent:provider-role:arrival-question). It names the question's transaction, so its stated entry is about it and it counts only as that question's answer (REQ-ORD-1). It carries the reserve's arrival notice of each credit, whole and unchanged, the same notice it sends of its own accord, so the answer is that notice under the question's transaction; or says nothing arrived; or refuses, without saying when it lifts, since the question counts as a balance check (REQ-CAT-4, INV-9).",
  "$ref": "urn:rutent:provider-role:statement-envelope",
  "properties": {
    "shape": {
      "const": "urn:rutent:provider-role:arrival-answer"
    },
    "statement": {
      "$ref": "#/$defs/answer"
    }
  },
  "$defs": {
    "answer": {
      "description": "The answer.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "transaction",
        "outcome"
      ],
      "properties": {
        "transaction": {
          "description": "The question's own transaction, which this answers (REQ-ORD-1).",
          "$ref": "urn:rutent:provider-role:common#/$defs/identifier"
        },
        "outcome": {
          "$ref": "#/$defs/outcome"
        }
      }
    },
    "outcome": {
      "description": "What arrived, nothing, or a refusal.",
      "type": "object",
      "required": [
        "status"
      ],
      "properties": {
        "status": {
          "enum": [
            "arrived",
            "nothing_arrived",
            "refused"
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "required": [
              "status"
            ],
            "properties": {
              "status": {
                "const": "arrived"
              }
            }
          },
          "then": {
            "$ref": "#/$defs/arrived"
          }
        },
        {
          "if": {
            "required": [
              "status"
            ],
            "properties": {
              "status": {
                "const": "nothing_arrived"
              }
            }
          },
          "then": {
            "$ref": "#/$defs/nothing_arrived"
          }
        },
        {
          "if": {
            "required": [
              "status"
            ],
            "properties": {
              "status": {
                "const": "refused"
              }
            }
          },
          "then": {
            "$ref": "urn:rutent:provider-role:result#/$defs/balance_refused"
          }
        }
      ]
    },
    "arrived": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "notices"
      ],
      "properties": {
        "status": {
          "const": "arrived"
        },
        "notices": {
          "description": "The reserve's own signed notice of each credit that arrived at the account, node and asset asked about, whole: at least one.",
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "urn:rutent:provider-role:arrival-notice"
          }
        }
      }
    },
    "nothing_arrived": {
      "description": "No credit arrived at the account, node and asset asked about. It says nothing else.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status"
      ],
      "properties": {
        "status": {
          "const": "nothing_arrived"
        }
      }
    }
  }
}
