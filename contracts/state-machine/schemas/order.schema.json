{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:rutent:state-machine:order",
  "title": "Order",
  "description": "The state the state machine's transition takes and returns: an order with exactly one current state, as one or more parts (REQ-ORD-42, DEC-8), each part a route with its own state, each segment with exactly one current state (REQ-STM-1). v0 always has one part.",
  "type": "object",
  "required": [
    "order_id",
    "state",
    "last_record",
    "last_input",
    "parts"
  ],
  "properties": {
    "order_id": {
      "type": "string",
      "minLength": 1
    },
    "state": {
      "$ref": "urn:rutent:state-machine:order-state"
    },
    "last_record": {
      "description": "The record id of the input that reached this state (REQ-STM-3): the pointer into the order's history.",
      "type": "string",
      "minLength": 1
    },
    "last_input": {
      "description": "The last input delivered to the order, applied or not, and what it did (REQ-AUD-1).",
      "$ref": "#/$defs/last_input"
    },
    "handed_on_from": {
      "description": "The order whose value this order was handed (REQ-ORD-43); that order's part points back here.",
      "type": "string",
      "minLength": 1
    },
    "parts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/part"
      }
    }
  },
  "additionalProperties": false,
  "allOf": [
    {
      "description": "A handed-on order has a part whose value was handed on.",
      "if": {
        "properties": {
          "state": {
            "const": "handed_on"
          }
        },
        "required": [
          "state"
        ]
      },
      "then": {
        "properties": {
          "parts": {
            "contains": {
              "properties": {
                "state": {
                  "const": "handed_on"
                }
              }
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "part": {
      "description": "One route of the order. Every rule about a route's ending applies to it, and it ends by itself (REQ-ORD-42), so it carries a state from the order-state list.",
      "type": "object",
      "required": [
        "part_id",
        "state",
        "segments"
      ],
      "properties": {
        "part_id": {
          "type": "string",
          "minLength": 1
        },
        "state": {
          "$ref": "urn:rutent:state-machine:order-state"
        },
        "linked_order": {
          "description": "The order this part's value was handed on to (REQ-ORD-43).",
          "type": "string",
          "minLength": 1
        },
        "segments": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/segment"
          }
        },
        "retired_segments": {
          "description": "The ids of segments a recalculation replaced. No segment id is reused in the order's life, retired ones included, so a late report about one matches nothing current; that uniqueness across parts and current segments is checked by the Rust types, which JSON Schema can't state.",
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "additionalProperties": false,
      "allOf": [
        {
          "description": "A handed-on part names the order its value went to, and only a handed-on part does.",
          "if": {
            "properties": {
              "state": {
                "const": "handed_on"
              }
            },
            "required": [
              "state"
            ]
          },
          "then": {
            "required": [
              "linked_order"
            ]
          },
          "else": {
            "not": {
              "required": [
                "linked_order"
              ]
            }
          }
        }
      ]
    },
    "segment": {
      "description": "A segment plan with its one current state.",
      "type": "object",
      "allOf": [
        {
          "$ref": "urn:rutent:state-machine:segment-plan"
        }
      ],
      "required": [
        "state"
      ],
      "properties": {
        "state": {
          "$ref": "urn:rutent:state-machine:segment-state"
        }
      },
      "unevaluatedProperties": false
    },
    "last_input": {
      "type": "object",
      "required": [
        "record_id",
        "outcome"
      ],
      "properties": {
        "record_id": {
          "type": "string",
          "minLength": 1
        },
        "outcome": {
          "$ref": "#/$defs/outcome"
        }
      },
      "additionalProperties": false
    },
    "outcome": {
      "description": "What the last input did. A repeat has a record id already applied or seen; a late input names a retired segment; a not-applicable one changed nothing, for a reason.",
      "oneOf": [
        {
          "type": "object",
          "required": [
            "outcome"
          ],
          "properties": {
            "outcome": {
              "const": "applied"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "outcome"
          ],
          "properties": {
            "outcome": {
              "const": "repeat"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "outcome"
          ],
          "properties": {
            "outcome": {
              "const": "late"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "outcome",
            "reason"
          ],
          "properties": {
            "outcome": {
              "const": "not_applicable"
            },
            "reason": {
              "enum": [
                "other_order",
                "unknown_subject",
                "ended",
                "not_from_this_state",
                "changes_destination",
                "reuses_segment_id"
              ]
            }
          },
          "additionalProperties": false
        }
      ]
    }
  }
}
