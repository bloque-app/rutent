{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:rutent:module-interface:secret-answer",
  "title": "Secret answer",
  "description": "The credential proxy's answer to one secret lookup, delivered to the calling outside part only (REQ-MDL-6). It is the one shape in this contract that carries secret plaintext. The value is the current one, so a rotated secret reaches the next lookup with no release (REQ-MDL-6).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "transaction",
    "operation",
    "name",
    "outcome"
  ],
  "properties": {
    "transaction": {
      "description": "The lookup's transaction.",
      "$ref": "urn:rutent:provider-role:common#/$defs/identifier"
    },
    "operation": {
      "description": "The lookup's outside operation.",
      "$ref": "urn:rutent:module-interface:common#/$defs/name"
    },
    "name": {
      "description": "The lookup's name.",
      "$ref": "urn:rutent:module-interface:common#/$defs/name"
    },
    "outcome": {
      "$ref": "#/$defs/outcome"
    }
  },
  "$defs": {
    "outcome": {
      "description": "Resolved, with the value; or refused, because the module doesn't declare the name for the lookup's operation (undeclared_secret), the caller's provider holds no secret by it (not_found), or the store couldn't be asked or gave no usable answer, so whether it holds one isn't known (store_unavailable).",
      "type": "object",
      "required": [
        "status"
      ],
      "properties": {
        "status": {
          "enum": [
            "resolved",
            "refused"
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "required": [
              "status"
            ],
            "properties": {
              "status": {
                "const": "resolved"
              }
            }
          },
          "then": {
            "$ref": "#/$defs/resolved"
          }
        },
        {
          "if": {
            "required": [
              "status"
            ],
            "properties": {
              "status": {
                "const": "refused"
              }
            }
          },
          "then": {
            "$ref": "#/$defs/refused"
          }
        }
      ]
    },
    "resolved": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "value"
      ],
      "properties": {
        "status": {
          "const": "resolved"
        },
        "value": {
          "description": "The secret's current plaintext.",
          "type": "string",
          "minLength": 1
        }
      }
    },
    "refused": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "reason"
      ],
      "properties": {
        "status": {
          "const": "refused"
        },
        "reason": {
          "enum": [
            "undeclared_secret",
            "not_found",
            "store_unavailable"
          ]
        }
      }
    }
  }
}
