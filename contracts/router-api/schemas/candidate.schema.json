{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:rutent:router-api:candidate",
  "title": "Route candidate",
  "description": "One candidate the router considered: a split of one or more parts, each a route, an ordered list of typed operations (REQ-ORD-37, REQ-QTE-16), and why it was dropped unless it was kept (REQ-AUD-4). A single route is a split of one part (DEC-8). That each operation starts where the one before it ended, with what it delivered, that an outside-band, beyond-levels, no-price, fee-above-amount, nothing-delivered or unconfirmed reason names an operation of the candidate, and that a beyond-levels, no-price, fee-above-amount or nothing-delivered reason names its part's last operation, which arrives with 0, are checked by the contract's Rust types.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "candidate_id",
    "parts"
  ],
  "properties": {
    "candidate_id": {
      "description": "Unique in its record.",
      "$ref": "urn:rutent:provider-role:common#/$defs/identifier"
    },
    "parts": {
      "description": "The parts; their amounts add up to the request's.",
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/part"
      }
    },
    "dropped": {
      "description": "Why the candidate was dropped; absent on a shortlisted candidate, or on the chosen one.",
      "$ref": "#/$defs/drop_reason"
    }
  },
  "$defs": {
    "part": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "operations"
      ],
      "properties": {
        "operations": {
          "description": "The route's operations, in order.",
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "urn:rutent:router-api:operation"
          }
        }
      }
    },
    "index": {
      "type": "integer",
      "minimum": 0,
      "maximum": 4294967295
    },
    "drop_reason": {
      "type": "object",
      "required": [
        "reason"
      ],
      "properties": {
        "reason": {
          "enum": [
            "stale_figure",
            "void_statement",
            "quote_voided",
            "dry_run_refused",
            "ineligible",
            "over_ceiling",
            "unconfirmed",
            "outside_band",
            "beyond_levels",
            "no_price",
            "fee_above_amount",
            "nothing_delivered",
            "excluded_by_policy",
            "below_floor",
            "no_positive_outcome",
            "suspect_rate_cycle",
            "outranked"
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "required": [
              "reason"
            ],
            "properties": {
              "reason": {
                "const": "stale_figure"
              }
            }
          },
          "then": {
            "description": "It cites a figure past its stated validity (REQ-QTE-4).",
            "type": "object",
            "additionalProperties": false,
            "required": [
              "reason",
              "figure"
            ],
            "properties": {
              "reason": {
                "const": "stale_figure"
              },
              "figure": {
                "$ref": "urn:rutent:provider-role:common#/$defs/identifier"
              }
            }
          }
        },
        {
          "if": {
            "required": [
              "reason"
            ],
            "properties": {
              "reason": {
                "const": "void_statement"
              }
            }
          },
          "then": {
            "description": "It cites a statement whose envelope names another deployment or protocol version than the policy bounds' (REQ-PRT-1).",
            "type": "object",
            "additionalProperties": false,
            "required": [
              "reason",
              "figure"
            ],
            "properties": {
              "reason": {
                "const": "void_statement"
              },
              "figure": {
                "$ref": "urn:rutent:provider-role:common#/$defs/identifier"
              }
            }
          }
        },
        {
          "if": {
            "required": [
              "reason"
            ],
            "properties": {
              "reason": {
                "const": "quote_voided"
              },
              "condition": {
                "$ref": "urn:rutent:provider-role:result#/$defs/voided_by/items"
              }
            }
          },
          "then": {
            "description": "A condition that voids a fresh quote it cites holds: the quote names the condition; for validity_passes it is past its validity, and for amount_changes an operation citing it takes in another amount (REQ-QTE-1).",
            "type": "object",
            "additionalProperties": false,
            "required": [
              "reason",
              "figure",
              "condition"
            ],
            "properties": {
              "reason": {
                "const": "quote_voided"
              },
              "figure": {
                "$ref": "urn:rutent:provider-role:common#/$defs/identifier"
              },
              "condition": {
                "$ref": "urn:rutent:provider-role:result#/$defs/voided_by/items"
              }
            }
          }
        },
        {
          "if": {
            "required": [
              "reason"
            ],
            "properties": {
              "reason": {
                "const": "dry_run_refused"
              }
            }
          },
          "then": {
            "description": "A dry run it cites was refused by the provider.",
            "type": "object",
            "additionalProperties": false,
            "required": [
              "reason",
              "figure"
            ],
            "properties": {
              "reason": {
                "const": "dry_run_refused"
              },
              "figure": {
                "$ref": "urn:rutent:provider-role:common#/$defs/identifier"
              }
            }
          }
        },
        {
          "if": {
            "required": [
              "reason"
            ],
            "properties": {
              "reason": {
                "const": "ineligible"
              }
            }
          },
          "then": {
            "description": "A judgement it cites answered no for a class one of its operations needs.",
            "type": "object",
            "additionalProperties": false,
            "required": [
              "reason",
              "figure"
            ],
            "properties": {
              "reason": {
                "const": "ineligible"
              },
              "figure": {
                "$ref": "urn:rutent:provider-role:common#/$defs/identifier"
              }
            }
          }
        },
        {
          "if": {
            "required": [
              "reason"
            ],
            "properties": {
              "reason": {
                "const": "over_ceiling"
              }
            }
          },
          "then": {
            "description": "Its value in flight, its parts counted together, would pass a ceiling of the policy bounds, matched on provider or publisher and on asset id and decimals (REQ-ORD-8).",
            "type": "object",
            "additionalProperties": false,
            "required": [
              "reason",
              "scope",
              "party",
              "asset"
            ],
            "properties": {
              "reason": {
                "const": "over_ceiling"
              },
              "scope": {
                "enum": [
                  "provider",
                  "publisher"
                ]
              },
              "party": {
                "$ref": "urn:rutent:provider-role:common#/$defs/identifier"
              },
              "asset": {
                "description": "The ceiling's asset and unit: a ceiling matches on both.",
                "$ref": "urn:rutent:provider-role:advertisement#/$defs/denomination"
              }
            }
          }
        },
        {
          "if": {
            "required": [
              "reason"
            ],
            "properties": {
              "reason": {
                "const": "unconfirmed"
              }
            }
          },
          "then": {
            "description": "In a choice round, one of its operations isn't confirmed: it cites no accepted dry-run answer of its provider for its tuple, at its amount, within its validity and not void.",
            "type": "object",
            "additionalProperties": false,
            "required": [
              "reason",
              "part",
              "operation"
            ],
            "properties": {
              "reason": {
                "const": "unconfirmed"
              },
              "part": {
                "$ref": "#/$defs/index"
              },
              "operation": {
                "$ref": "#/$defs/index"
              }
            }
          }
        },
        {
          "if": {
            "required": [
              "reason"
            ],
            "properties": {
              "reason": {
                "const": "outside_band"
              }
            }
          },
          "then": {
            "description": "An operation's amount falls outside its provider's band, after the fees before it, or above its price's last level (REQ-QTE-12).",
            "type": "object",
            "additionalProperties": false,
            "required": [
              "reason",
              "part",
              "operation"
            ],
            "properties": {
              "reason": {
                "const": "outside_band"
              },
              "part": {
                "$ref": "#/$defs/index"
              },
              "operation": {
                "$ref": "#/$defs/index"
              }
            }
          }
        },
        {
          "if": {
            "required": [
              "reason"
            ],
            "properties": {
              "reason": {
                "const": "beyond_levels"
              }
            }
          },
          "then": {
            "description": "An operation's net amount is above its price's last level, so the price serves it nothing (REQ-QTE-12, ADR-0006): the part is listed only up to and including that operation, which arrives with 0. That the net is above the last level, that the operation is its part's last, and that it arrives with 0 are checked by the contract's Rust types.",
            "type": "object",
            "additionalProperties": false,
            "required": [
              "reason",
              "part",
              "operation"
            ],
            "properties": {
              "reason": {
                "const": "beyond_levels"
              },
              "part": {
                "$ref": "#/$defs/index"
              },
              "operation": {
                "$ref": "#/$defs/index"
              }
            }
          }
        },
        {
          "if": {
            "required": [
              "reason"
            ],
            "properties": {
              "reason": {
                "const": "no_price"
              }
            }
          },
          "then": {
            "description": "An operation runs through a tuple the snapshot holds no price for, so its terms can't be stated (REQ-AUD-4): the part is listed only up to and including that operation, which states a fee of 0 and arrives with 0, and cites its tuple and no price. That the operation is its part's last, its fee and output 0, and that the snapshot holds no price for its tuple are checked by the contract's Rust types.",
            "type": "object",
            "additionalProperties": false,
            "required": [
              "reason",
              "part",
              "operation"
            ],
            "properties": {
              "reason": {
                "const": "no_price"
              },
              "part": {
                "$ref": "#/$defs/index"
              },
              "operation": {
                "$ref": "#/$defs/index"
              }
            }
          }
        },
        {
          "if": {
            "required": [
              "reason"
            ],
            "properties": {
              "reason": {
                "const": "fee_above_amount"
              }
            }
          },
          "then": {
            "description": "An operation's fee, by its price's formula and counted at its maximum where one is given, is above the amount that reaches it, so it can't be stated (REQ-QTE-5, REQ-AUD-4): the part is listed only up to and including that operation, which states its amount in as its fee and arrives with 0. That the operation is its part's last, its fee and output, and that it cites no usable accepted answer at its amount in are checked by the contract's Rust types; that the formula's fee is above its amount in, by the router suite.",
            "type": "object",
            "additionalProperties": false,
            "required": [
              "reason",
              "part",
              "operation"
            ],
            "properties": {
              "reason": {
                "const": "fee_above_amount"
              },
              "part": {
                "$ref": "#/$defs/index"
              },
              "operation": {
                "$ref": "#/$defs/index"
              }
            }
          }
        },
        {
          "if": {
            "required": [
              "reason"
            ],
            "properties": {
              "reason": {
                "const": "nothing_delivered"
              }
            }
          },
          "then": {
            "description": "An operation short of the destination delivers nothing, so nothing after it can be stated (REQ-QTE-13, REQ-AUD-4): the part is listed only up to and including that operation, which arrives with 0. That the operation is its part's last, arrives with 0 and doesn't end at the destination are checked by the contract's Rust types; its terms, by the router suite, as any operation's.",
            "type": "object",
            "additionalProperties": false,
            "required": [
              "reason",
              "part",
              "operation"
            ],
            "properties": {
              "reason": {
                "const": "nothing_delivered"
              },
              "part": {
                "$ref": "#/$defs/index"
              },
              "operation": {
                "$ref": "#/$defs/index"
              }
            }
          }
        },
        {
          "if": {
            "required": [
              "reason"
            ],
            "properties": {
              "reason": {
                "const": "excluded_by_policy"
              }
            }
          },
          "then": {
            "description": "It uses a provider or tuple the policy excludes (REQ-QTE-11).",
            "type": "object",
            "additionalProperties": false,
            "required": [
              "reason"
            ],
            "properties": {
              "reason": {
                "const": "excluded_by_policy"
              }
            }
          }
        },
        {
          "if": {
            "required": [
              "reason"
            ],
            "properties": {
              "reason": {
                "const": "below_floor"
              }
            }
          },
          "then": {
            "description": "It would arrive below the customer's floor (REQ-ORD-27).",
            "type": "object",
            "additionalProperties": false,
            "required": [
              "reason"
            ],
            "properties": {
              "reason": {
                "const": "below_floor"
              }
            }
          }
        },
        {
          "if": {
            "required": [
              "reason"
            ],
            "properties": {
              "reason": {
                "const": "no_positive_outcome"
              }
            }
          },
          "then": {
            "description": "One of its parts arrives with nothing (REQ-QTE-13).",
            "type": "object",
            "additionalProperties": false,
            "required": [
              "reason"
            ],
            "properties": {
              "reason": {
                "const": "no_positive_outcome"
              }
            }
          }
        },
        {
          "if": {
            "required": [
              "reason"
            ],
            "properties": {
              "reason": {
                "const": "suspect_rate_cycle"
              }
            }
          },
          "then": {
            "description": "It follows a rate cycle that implies free profit, possibly stale or false (ADR-0006).",
            "type": "object",
            "additionalProperties": false,
            "required": [
              "reason"
            ],
            "properties": {
              "reason": {
                "const": "suspect_rate_cycle"
              }
            }
          }
        },
        {
          "if": {
            "required": [
              "reason"
            ],
            "properties": {
              "reason": {
                "const": "outranked"
              }
            }
          },
          "then": {
            "description": "Another candidate comes first by the objective and its tie-break, candidate_id ascending (REQ-QTE-11).",
            "type": "object",
            "additionalProperties": false,
            "required": [
              "reason",
              "by"
            ],
            "properties": {
              "reason": {
                "const": "outranked"
              },
              "by": {
                "$ref": "urn:rutent:provider-role:common#/$defs/identifier"
              }
            }
          }
        }
      ]
    }
  }
}
