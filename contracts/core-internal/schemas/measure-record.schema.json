{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:rutent:core-internal:measure-record",
  "title": "Measure record",
  "description": "One record the bulk measures read, per provider or verifier: a quote against the price executed, a dry run against the outcome, a failure against the market's direction, a refusal, a reversal, or an answer towards the rate of no (REQ-AUD-7). It is rutent's record of what it measured, citing the entries it rests on.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "provider",
    "order",
    "measure",
    "cites",
    "at"
  ],
  "properties": {
    "provider": {
      "description": "The provider or verifier it measures.",
      "$ref": "urn:rutent:provider-role:common#/$defs/identifier"
    },
    "order": {
      "$ref": "urn:rutent:provider-role:common#/$defs/identifier"
    },
    "segment": {
      "description": "The segment, where it is about one.",
      "$ref": "urn:rutent:provider-role:common#/$defs/identifier"
    },
    "measure": {
      "$ref": "#/$defs/measure"
    },
    "cites": {
      "description": "The receipts of the entries it rests on, at least one, each once: a provider's word stays in its stated entry.",
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "urn:rutent:core-internal:receipt"
      }
    },
    "at": {
      "description": "When, by Core's clock, the one it passes as at.",
      "$ref": "urn:rutent:provider-role:common#/$defs/timestamp"
    }
  },
  "$defs": {
    "measure": {
      "description": "What it counts.",
      "type": "object",
      "required": [
        "kind"
      ],
      "properties": {
        "kind": {
          "enum": [
            "quote",
            "dry_run",
            "failure",
            "refusal",
            "reversal",
            "answer"
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "required": [
              "kind"
            ],
            "properties": {
              "kind": {
                "const": "quote"
              }
            }
          },
          "then": {
            "$ref": "#/$defs/measure_quote"
          }
        },
        {
          "if": {
            "required": [
              "kind"
            ],
            "properties": {
              "kind": {
                "const": "dry_run"
              }
            }
          },
          "then": {
            "$ref": "#/$defs/measure_dry_run"
          }
        },
        {
          "if": {
            "required": [
              "kind"
            ],
            "properties": {
              "kind": {
                "const": "failure"
              }
            }
          },
          "then": {
            "$ref": "#/$defs/measure_failure"
          }
        },
        {
          "if": {
            "required": [
              "kind"
            ],
            "properties": {
              "kind": {
                "const": "refusal"
              }
            }
          },
          "then": {
            "$ref": "#/$defs/measure_refusal"
          }
        },
        {
          "if": {
            "required": [
              "kind"
            ],
            "properties": {
              "kind": {
                "const": "reversal"
              }
            }
          },
          "then": {
            "$ref": "#/$defs/measure_reversal"
          }
        },
        {
          "if": {
            "required": [
              "kind"
            ],
            "properties": {
              "kind": {
                "const": "answer"
              }
            }
          },
          "then": {
            "$ref": "#/$defs/measure_answer"
          }
        }
      ]
    },
    "said": {
      "description": "A yes or a no.",
      "enum": [
        "yes",
        "no"
      ]
    },
    "measure_quote": {
      "description": "A quote against the price executed.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "quoted",
        "executed",
        "asset"
      ],
      "properties": {
        "kind": {
          "const": "quote"
        },
        "quoted": {
          "description": "The amount quoted, in the asset's unit.",
          "$ref": "urn:rutent:provider-role:common#/$defs/amount"
        },
        "executed": {
          "description": "The amount executed.",
          "$ref": "urn:rutent:provider-role:common#/$defs/amount"
        },
        "asset": {
          "$ref": "urn:rutent:provider-role:advertisement#/$defs/denomination"
        }
      }
    },
    "measure_dry_run": {
      "description": "A dry run against the segment's outcome.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "said",
        "outcome"
      ],
      "properties": {
        "kind": {
          "const": "dry_run"
        },
        "said": {
          "$ref": "#/$defs/said"
        },
        "outcome": {
          "description": "How the segment ended.",
          "enum": [
            "done",
            "failed"
          ]
        }
      }
    },
    "measure_failure": {
      "description": "A failure, against the market's direction where a figure for it is held.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind"
      ],
      "properties": {
        "kind": {
          "const": "failure"
        },
        "market": {
          "description": "The market's direction over the segment against the provider's interest, absent until a market figure is held.",
          "enum": [
            "with_the_provider",
            "against_the_provider",
            "flat"
          ]
        }
      }
    },
    "measure_refusal": {
      "description": "A refusal.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind"
      ],
      "properties": {
        "kind": {
          "const": "refusal"
        }
      }
    },
    "measure_reversal": {
      "description": "A reversal.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind"
      ],
      "properties": {
        "kind": {
          "const": "reversal"
        }
      }
    },
    "measure_answer": {
      "description": "An answer, counted towards the rate of no.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "said"
      ],
      "properties": {
        "kind": {
          "const": "answer"
        },
        "said": {
          "$ref": "#/$defs/said"
        }
      }
    }
  }
}
