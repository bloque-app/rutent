{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:rutent:core-internal:raise",
  "title": "Raise",
  "description": "A raise to the operator: a difference and the entries it rests on, and nothing that can move value or change an order, so a raise only detects (REQ-ORD-9, REQ-AUD-15, ADR-0009). That the difference is a real one (two amounts or times that differ, a charge above its maximum) is checked by the Rust types.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "raise",
    "difference",
    "cites",
    "at"
  ],
  "properties": {
    "raise": {
      "description": "The raise's id.",
      "$ref": "urn:rutent:provider-role:common#/$defs/identifier"
    },
    "difference": {
      "$ref": "#/$defs/difference"
    },
    "cites": {
      "description": "The receipts of the entries it rests on, at least one, each once.",
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "urn:rutent:core-internal:receipt"
      }
    },
    "at": {
      "description": "When, by Core's clock, the one it passes as at.",
      "$ref": "urn:rutent:provider-role:common#/$defs/timestamp"
    }
  },
  "$defs": {
    "difference": {
      "description": "The difference.",
      "type": "object",
      "required": [
        "kind"
      ],
      "properties": {
        "kind": {
          "enum": [
            "reports",
            "holding",
            "charge",
            "settlement_time"
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "required": [
              "kind"
            ],
            "properties": {
              "kind": {
                "const": "reports"
              }
            }
          },
          "then": {
            "$ref": "#/$defs/difference_reports"
          }
        },
        {
          "if": {
            "required": [
              "kind"
            ],
            "properties": {
              "kind": {
                "const": "holding"
              }
            }
          },
          "then": {
            "$ref": "#/$defs/difference_holding"
          }
        },
        {
          "if": {
            "required": [
              "kind"
            ],
            "properties": {
              "kind": {
                "const": "charge"
              }
            }
          },
          "then": {
            "$ref": "#/$defs/difference_charge"
          }
        },
        {
          "if": {
            "required": [
              "kind"
            ],
            "properties": {
              "kind": {
                "const": "settlement_time"
              }
            }
          },
          "then": {
            "$ref": "#/$defs/difference_settlement_time"
          }
        }
      ]
    },
    "difference_charge": {
      "description": "A provider charged above its formula's maximum (REQ-QTE-5).",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "order",
        "segment",
        "provider",
        "charged",
        "maximum",
        "asset",
        "result"
      ],
      "properties": {
        "kind": {
          "const": "charge"
        },
        "order": {
          "$ref": "urn:rutent:provider-role:common#/$defs/identifier"
        },
        "segment": {
          "$ref": "urn:rutent:provider-role:common#/$defs/identifier"
        },
        "provider": {
          "$ref": "urn:rutent:provider-role:common#/$defs/identifier"
        },
        "charged": {
          "description": "What it charged, in the asset's unit.",
          "$ref": "urn:rutent:provider-role:common#/$defs/amount"
        },
        "maximum": {
          "description": "Its formula's maximum.",
          "$ref": "urn:rutent:provider-role:common#/$defs/amount"
        },
        "asset": {
          "$ref": "urn:rutent:provider-role:advertisement#/$defs/denomination"
        },
        "result": {
          "description": "The receipt of the stated entry of the result whose charge this is: its provider's verified result about the order and segment.",
          "$ref": "urn:rutent:core-internal:receipt"
        },
        "terms": {
          "description": "The receipt of the stated entry of the provider's signed terms (urn:rutent:provider-role:terms) whose formula the charge is above, in force at the segment's start: binding from the later of its made_at and its received_at, no later than the segment's move took effect. Absent where the provider stated none by then, so the price its route was priced on bound it.",
          "$ref": "urn:rutent:core-internal:receipt"
        }
      }
    },
    "difference_settlement_time": {
      "description": "A material change in a provider's p99 settlement time (REQ-ORD-6).",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "provider",
        "before_seconds",
        "now_seconds"
      ],
      "properties": {
        "kind": {
          "const": "settlement_time"
        },
        "provider": {
          "$ref": "urn:rutent:provider-role:common#/$defs/identifier"
        },
        "before_seconds": {
          "description": "The p99 before, in seconds.",
          "$ref": "urn:rutent:provider-role:common#/$defs/safe_integer"
        },
        "now_seconds": {
          "description": "The p99 now, in seconds.",
          "$ref": "urn:rutent:provider-role:common#/$defs/safe_integer"
        }
      }
    },
    "difference_reports": {
      "description": "A segment's two reports disagree (REQ-ORD-9).",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "order",
        "segment",
        "sent",
        "received",
        "asset"
      ],
      "properties": {
        "kind": {
          "const": "reports"
        },
        "order": {
          "description": "The order raised.",
          "$ref": "urn:rutent:provider-role:common#/$defs/identifier"
        },
        "segment": {
          "$ref": "urn:rutent:provider-role:common#/$defs/identifier"
        },
        "sent": {
          "description": "What the sending party reports it sent.",
          "$ref": "urn:rutent:provider-role:common#/$defs/amount"
        },
        "received": {
          "description": "What the receiving party reports it received.",
          "$ref": "urn:rutent:provider-role:common#/$defs/amount"
        },
        "asset": {
          "$ref": "urn:rutent:provider-role:advertisement#/$defs/denomination"
        }
      }
    },
    "difference_holding": {
      "description": "A holding account's balance and the value held there for orders disagree (REQ-AUD-15).",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "account",
        "direction",
        "by",
        "asset",
        "word"
      ],
      "properties": {
        "kind": {
          "const": "holding"
        },
        "account": {
          "description": "The holding account.",
          "$ref": "urn:rutent:provider-role:common#/$defs/identifier"
        },
        "direction": {
          "description": "Which way it is off.",
          "enum": [
            "short",
            "over"
          ]
        },
        "by": {
          "description": "By how much, in the asset's unit.",
          "$ref": "urn:rutent:provider-role:common#/$defs/positive_amount"
        },
        "asset": {
          "$ref": "urn:rutent:provider-role:advertisement#/$defs/denomination"
        },
        "word": {
          "description": "Whose word the balance was.",
          "enum": [
            "checked",
            "publisher"
          ]
        }
      }
    }
  }
}
