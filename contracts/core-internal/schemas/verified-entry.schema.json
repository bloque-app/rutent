      "description": "How it came out.",
      "type": "object",
      "required": [
        "status"
      ],
      "properties": {
        "status": {
          "enum": [
            "permitted",
            "refused",
            "not_known",
            "to_take_effect",
            "done",
            "failed",
            "unanswered",
            "observed"
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "required": [
              "status"
            ],
            "properties": {
              "status": {
                "const": "permitted"
              }
            }
          },
          "then": {
            "$ref": "#/$defs/outcome_permitted"
          }
        },
        {
          "if": {
            "required": [
              "status"
            ],
            "properties": {
              "status": {
                "const": "refused"
              }
            }
          },
          "then": {
            "$ref": "#/$defs/outcome_refused"
          }
        },
        {
          "if": {
            "required": [
              "status"
            ],
            "properties": {
              "status": {
                "const": "not_known"
              }
            }
          },
          "then": {
            "$ref": "#/$defs/outcome_not_known"
          }
        },
        {
          "if": {
            "required": [
              "status"
            ],
            "properties": {
              "status": {
                "const": "to_take_effect"
              }
            }
          },
          "then": {
            "$ref": "#/$defs/outcome_to_take_effect"
          }
        },
        {
          "if": {
            "required": [
              "status"
            ],
            "properties": {
              "status": {
                "const": "done"
              }
            }
          },
          "then": {
            "$ref": "#/$defs/outcome_done"
          }
        },
        {
          "if": {
            "required": [
              "status"
            ],
            "properties": {
              "status": {
                "const": "failed"
              }
            }
          },
          "then": {
            "$ref": "#/$defs/outcome_failed"
          }
        },
        {
          "if": {
            "required": [
              "status"
            ],
            "properties": {
              "status": {
                "const": "unanswered"
              }
            }
          },
          "then": {
            "$ref": "#/$defs/outcome_unanswered"
          }
        },
        {
          "if": {
            "required": [
              "status"
            ],
            "properties": {
              "status": {
                "const": "observed"
              }
            }
          },
          "then": {
            "$ref": "#/$defs/outcome_observed"
          }
        }
      ]
    },
