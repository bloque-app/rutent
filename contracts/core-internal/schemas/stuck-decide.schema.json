{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:rutent:core-internal:stuck-decide",
  "title": "Stuck order: decide",
  "description": "The decide step of resolving a stuck order: one actor names the outcome and the evidence relied on (REQ-AUZ-4, ADR-0011). Policy answers with a decision.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "request",
    "order",
    "part",
    "decider",
    "resolution",
    "evidence",
    "at"
  ],
  "properties": {
    "request": {
      "description": "The request's id, which its answer names.",
      "$ref": "urn:rutent:provider-role:common#/$defs/identifier"
    },
    "order": {
      "description": "The stuck order.",
      "$ref": "urn:rutent:provider-role:common#/$defs/identifier"
    },
    "part": {
      "description": "The order's stuck part: a resolution resolves one part, and the log admits it only for a part that stands stuck.",
      "$ref": "urn:rutent:provider-role:common#/$defs/identifier"
    },
    "decider": {
      "description": "Who decides.",
      "$ref": "urn:rutent:core-internal:common#/$defs/actor"
    },
    "resolution": {
      "$ref": "#/$defs/resolution"
    },
    "evidence": {
      "description": "The evidence relied on, by digest, at least one, each once.",
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "urn:rutent:module-interface:common#/$defs/digest"
      }
    },
    "at": {
      "description": "When, by Core's clock, the one it passes as at.",
      "$ref": "urn:rutent:provider-role:common#/$defs/timestamp"
    }
  },
  "$defs": {
    "resolution": {
      "description": "The outcome decided: which provider moves how much of which asset, and where to or on to which linked order.",
      "type": "object",
      "required": [
        "kind"
      ],
      "properties": {
        "kind": {
          "enum": [
            "deliver",
            "hand_on"
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "required": [
              "kind"
            ],
            "properties": {
              "kind": {
                "const": "deliver"
              }
            }
          },
          "then": {
            "$ref": "#/$defs/resolution_deliver"
          }
        },
        {
          "if": {
            "required": [
              "kind"
            ],
            "properties": {
              "kind": {
                "const": "hand_on"
              }
            }
          },
          "then": {
            "$ref": "#/$defs/resolution_hand_on"
          }
        }
      ]
    },
    "resolution_deliver": {
      "description": "The value moves to a destination.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "by",
        "to",
        "asset",
        "amount"
      ],
      "properties": {
        "kind": {
          "const": "deliver"
        },
        "by": {
          "description": "The provider that moves the value: the decide step names it, so the move step can't choose another.",
          "$ref": "urn:rutent:provider-role:common#/$defs/identifier"
        },
        "to": {
          "description": "Where the value goes: the order's destination, or back to its origin.",
          "$ref": "urn:rutent:core-internal:common#/$defs/destination"
        },
        "asset": {
          "$ref": "urn:rutent:provider-role:advertisement#/$defs/denomination"
        },
        "amount": {
          "description": "The amount, in the asset's unit.",
          "$ref": "urn:rutent:provider-role:common#/$defs/positive_amount"
        }
      }
    },
    "resolution_hand_on": {
      "description": "The value is handed on to a linked order, the operator acting under REQ-AUZ-4.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "by",
        "linked_order",
        "asset",
        "amount"
      ],
      "properties": {
        "kind": {
          "const": "hand_on"
        },
        "by": {
          "description": "The provider whose holding account holds the value.",
          "$ref": "urn:rutent:provider-role:common#/$defs/identifier"
        },
        "linked_order": {
          "description": "The linked order the value goes on to, starting from that holding account as its origin reserve; its records point back here (REQ-ORD-13, REQ-ORD-43).",
          "$ref": "urn:rutent:provider-role:common#/$defs/identifier"
        },
        "asset": {
          "$ref": "urn:rutent:provider-role:advertisement#/$defs/denomination"
        },
        "amount": {
          "description": "The amount, in the asset's unit.",
          "$ref": "urn:rutent:provider-role:common#/$defs/positive_amount"
        }
      }
    }
  }
}
