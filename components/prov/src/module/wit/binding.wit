/// The Wasm binding's interface for the module-interface contract (`EXP-2`, `T-008-02`, item `exp2-wasm-shape`).
///
/// A module is two components, one per part. Nothing here is the contract: it is how this binding carries the
/// contract's shapes to and from each part. Every import is served by the platform, outside the provider's process,
/// and attributed to the provider by the process the call came from, never by anything in the call (`DEC-9`).
package rutent:binding@0.2.0;

/// The sandboxed part's one route outward: an outside request, the contract's
/// `urn:rutent:module-interface:outside-request` as JSON, answered with an outside response as JSON. The platform
/// checks the request against the running declaration before the outside part sees it.
interface outside-requests {
    request: func(outside-request: string) -> string;
}

/// What the sandboxed part has no route to. Each attempt is recorded by the platform and goes no further: there is no
/// proxy and no state behind these functions, and they return nothing. They exist so that a hostile module's attempt
/// is evidence, not silence (the module-boundary suite's `Step::LookUpSecret` and `Step::ReadState` for the
/// sandboxed part). An attempt names no operation: the platform records it under one it knows itself.
interface denied {
    look-up-secret: func(name: string);
    read-state: func(key: string);
}

/// The credential proxy, for the outside part (`REQ-MDL-6`): one declared secret, by name, for the transaction and
/// outside operation being served. The lookup names no provider.
interface proxy {
    enum secret-refusal {
        undeclared-secret,
        not-found,
        /// The store couldn't be asked or gave no usable answer, so whether the secret exists isn't known. It is
        /// never `not-found` (`REQ-MDL-17`).
        store-unavailable,
    }
    look-up: func(transaction: string, operation: string, name: string) -> result<string, secret-refusal>;
}

/// The provider's own state, for the outside part.
interface state {
    read: func(key: string) -> option<string>;
}

/// The egress layer (item `exp2-outside-egress`): one outbound call for the outside operation being served. The call
/// carries a whole request. The platform checks every hop against the running declaration, frames the message itself
/// (a request never sets `Host` or what delimits its body), drops every credential header when a redirect leaves the
/// endpoint, and writes the outbound call record; the module sees only the outcome.
interface egress {
    enum scheme {
        https,
        wss,
    }
    enum outcome {
        completed,
        failed,
        unknown,
        refused,
    }
    /// An HTTP method an outside part may use.
    enum method {
        get,
        post,
        put,
        patch,
        delete,
    }
    /// One request header. A header the guest marks `sensitive`, and one named `authorization`,
    /// `proxy-authorization` or `cookie` in any case, is a credential: a redirect to another endpoint drops it.
    record header {
        name: string,
        value: string,
        sensitive: bool,
    }
    /// The request: a method, an origin-form target (a path, with its query if any), headers and a body. It names no
    /// host: the destination is the call's scheme, host and port, and the platform refuses one not declared.
    record request {
        method: method,
        path: string,
        headers: list<header>,
        body: string,
    }
    call: func(operation: string, scheme: scheme, host: string, port: u16, request: request) -> outcome;
}

/// Cross-module calls (`REQ-MDL-21`): ask another provider's module one operation kind, through the platform. The
/// outcome is the call's record's (module-interface's `cross-module-call`).
interface modules {
    enum call-outcome {
        /// The platform passed the call on and the callee answered.
        delivered,
        /// The platform passed the call on and no answer came: the callee stopped, was stopped by a limit or its
        /// deadline, or gave no answer the platform could read. What the callee did is not known, so this is never
        /// `refused`: the callee may have acted on it (`REQ-ORD-1`).
        unanswered,
        /// The platform refused the call and passed nothing on.
        refused,
    }
    call: func(callee: string, kind: string) -> call-outcome;
}

/// The sandboxed part: it computes.
world sandboxed {
    import outside-requests;
    import denied;

    /// Called once when its provider's process starts it. An error means the release doesn't start.
    export start: func() -> result<_, string>;
    /// One provider-role operation, in the operator's envelope, as JSON; the result body's bytes as the part emits
    /// them.
    export handle: func(operation: string) -> list<u8>;
}

/// The outside part: the provider's own code, doing all of the module's outside interaction.
world outside {
    import proxy;
    import state;
    import egress;
    import modules;

    /// Called once when its provider's process starts it. An error means the release doesn't start.
    export start: func() -> result<_, string>;
    /// One outside request, as JSON; its outside response, as JSON.
    export perform: func(outside-request: string) -> string;
}
